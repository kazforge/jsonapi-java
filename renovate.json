{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "packageRules": [
    {
      "description": "Java compatibility versions are explicit CI matrix intent, not Renovate-managed dependencies. Keep updating the setup-java action itself.",
      "matchManagers": ["github-actions"],
      "matchDatasources": ["java-version"],
      "matchPackageNames": ["java", "java-jdk", "java-jre"],
      "enabled": false
    },
    {
      "description": "Jackson minimum versions, including shared annotations, are explicit compatibility baselines.",
      "matchManagers": ["gradle"],
      "matchJsonata": ["sharedVariableName in ['jackson3.minimum', 'jackson.annotations.minimum']"],
      "enabled": false
    },
    {
      "description": "Keep the CycloneDX Jackson constraint separate from the Jackson 3 compatibility target.",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["com.fasterxml.jackson.core:jackson-core"],
      "groupName": "Jackson 2 tooling"
    },
    {
      "description": "Keep the current Jackson 3 compatibility test dependencies on major 3.",
      "matchManagers": ["gradle"],
      "matchJsonata": ["sharedVariableName = 'jackson3.current'"],
      "allowedVersions": "/^3\\./"
    }
  ],
  "vulnerabilityAlerts": {"semanticCommitType": "fix"}
}
